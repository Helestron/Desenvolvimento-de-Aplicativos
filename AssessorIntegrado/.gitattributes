# ============================================================================
#  Fim de linha e arquivos binários do Assessor Integrado
#
#  Os .bat PRECISAM de CRLF: com fim de linha LF, o cmd.exe erra saltos
#  (goto, call :rótulo) em arquivos maiores que 512 bytes - foi assim que 6
#  dos 7 .bat do Assessor SAJ saíram do ZIP. Os .ps1 também vão com CRLF
#  (e com BOM UTF-8, que o git preserva como conteúdo). Com estas regras, o
#  checkout em qualquer sistema - e o ZIP que o GitHub gera - sai certo.
# ============================================================================
*               text=auto
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf
# O Bloco de Notas anterior ao Windows 10 1809 mostra LF como uma linha só.
/LEIA-ME.txt    text eol=crlf

*.png           binary
*.ico           binary
*.jpg           binary
*.pdf           binary
*.docx          binary
*.xlsx          binary
*.xls           binary
*.zip           binary
*.gz            binary
*.bz2           binary
*.onnx          binary
*.bin           binary
*.wav           binary
*.flac          binary
