<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifesto do Helestron.exe (vai dentro do executável, pelo helestron.rc).

  * asInvoker: nunca pede administrador (a instalação é por usuário);
  * supportedOS Windows 10/11: o Windows não aplica os "modos de
    compatibilidade" de versões antigas;
  * PerMonitorV2: nítido em monitor com zoom de 125 % ou 150 % e ao mudar a
    janela de monitor (sem isso, o Windows estica a janela e ela fica borrada);
  * longPathAware: caminhos com mais de 260 caracteres (pastas de rede do
    tribunal, nomes de processo longos) - vale quando a política do Windows
    também os libera;
  * Common Controls 6: as caixas de mensagem com o visual atual do Windows.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Helestron.Helestron" version="@VERSAO_WIN@" processorArchitecture="amd64"/>
  <description>Helestron</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
